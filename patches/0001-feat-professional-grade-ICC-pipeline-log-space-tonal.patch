+        vec3<f32>(adj00, adj01, adj02),   // adj row 0 → inverse col 0
+        vec3<f32>(adj10, adj11, adj12),   // adj row 1 → inverse col 1
+        vec3<f32>(adj20, adj21, adj22),   // adj row 2 → inverse col 2
